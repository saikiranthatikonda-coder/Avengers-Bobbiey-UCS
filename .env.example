# ═══ Bobbiey UCS configuration ═══
# Copy to .env and fill in. Everything here is optional except where noted —
# the platform degrades gracefully and tells you what's missing in the UI.
# (start-jarvis.cmd copies this automatically on first run.)

# ── news feed ────────────────────────────────────────────────────
# Free key at https://newsapi.org/register — without it the news card is idle.
NEWSAPI_KEY=

# ── server binding ───────────────────────────────────────────────
# 127.0.0.1 = local only (default, safest).
# 0.0.0.0   = reachable on your LAN, required for fleet nodes / remote access.
#             Remote dashboard access stays BLOCKED until you set an access
#             password in the REMOTE ACCESS & AUTH panel.
# NOTE: run.ps1 reads these from this file, so editing here is enough.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# ── voice output (agents speak aloud) ────────────────────────────
JARVIS_TTS=1
JARVIS_VOICE_NAME=Microsoft David Desktop
JARVIS_VOICE_RATE=180
# Runtime mute/volume live in audio_pref.json (🔊 control in the dashboard header).

# ── wake-word listener + speech-to-text ──────────────────────────
# 1 enables the microphone loop ("Hey Jarvis", "Hey Stark", …). 0 = mic off.
JARVIS_VOICE=0
# accuracy ⇄ speed: tiny.en | base.en | small | distil-small.en | distil-large-v3
# `small` handles Indian-accented English far better than base.en.
JARVIS_WHISPER_MODEL=small
JARVIS_VOICE_THRESHOLD=300

# ── cloud brain (Claude Code CLI) ────────────────────────────────
# MACHINE-SPECIFIC — update this after migrating to a new laptop.
#   Windows: where.exe claude      macOS/Linux: which claude
# Install with: npm i -g @anthropic-ai/claude-code
# Also powers webcam vision (local models are text-only).
CLAUDE_BIN=claude

# ── local / offline LLM (OpenAI-compatible) ──────────────────────
# Ollama:    http://127.0.0.1:11434/v1   (ollama serve + ollama pull qwen3:1.7b)
# LM Studio: http://127.0.0.1:1234/v1
# Point at another machine's IP to borrow its GPU.
# Your selected brain persists in model_pref.json.
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_KEY=

# ── insights engine ─────────────────────────────────────────────
# AI observation every 90s. 0 to disable.
JARVIS_INSIGHTS=1

# ── multi-site fleet (Phase 4) ──────────────────────────────────
# Optional: pin the fleet token instead of the auto-generated fleet_token.txt.
# Nodes normally pair with the 6-char code from the ADD NODE panel instead.
JARVIS_FLEET_TOKEN=
# Friendly name for THIS machine in the fleet (defaults to hostname).
JARVIS_NODE_NAME=

# ── enterprise / security (Phase 4) ─────────────────────────────
# Optional PIN required to elevate a session back to COMMANDER.
JARVIS_PIN=

# ── node agent only (set on the joining laptop, not the host) ────
# JARVIS_SERVER=http://<host-lan-ip>:8765
# JARVIS_PAIR_CODE=ABC123
# JARVIS_NODE_INTERVAL=5

# ── Web3 (Phase 6, optional) ─────────────────────────────────────
# NOT configured here — everything lives in web3_config.json, editable from the
# dashboard or via POST /api/web3/config. To adopt a real token later, set
# token.contract to a deployed ERC-20 and the layer reads live on-chain data.
